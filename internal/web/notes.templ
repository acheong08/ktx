package web

import "github.com/acheong08/ktx/internal/notes"

import "slices"

import "strconv"

templ notesListPage(v notesView) {
	@layout("Notes", v.Chrome) {
		<h1>Notes</h1>
		<form method="post" action="/notes" class="scratchpad">
			<label for="note-body" class="visually-hidden">New note</label>
			<textarea id="note-body" name="body" rows="8" placeholder="Write anything… (Markdown)" required autofocus data-ctrl-enter-submits>{ v.Draft }</textarea>
			@labelPicker(v.Labels, v.Picked)
			@graphFields(v.Graph, true, v.Title)
			<div class="scratchpad-actions">
				<button type="submit" class="primary">Save note</button>
				<span class="help">
					Ctrl/⌘ + Enter saves.
					if v.AIOff {
						The title is the first line (no AI key set).
					} else if len(v.Labels) > 0 {
						A title is written for you, and labels that fit are added.
					} else {
						A title is written for you.
					}
				</span>
			</div>
		</form>
		<form id="note-filters" class="filters" action="/notes" method="get" hx-get="/notes" hx-target="#note-results" hx-push-url="true" hx-trigger="input delay:300ms, submit">
			<input type="search" name="q" value={ v.Q } placeholder="Search notes…" aria-label="Search notes" autocomplete="off"/>
		</form>
		<div id="note-results">
			@noteResults(v)
		</div>
	}
}

templ noteResults(v notesView) {
	@flashBox(v.Flash)
	<nav class="kinds" aria-label="Kinds">
		for _, t := range v.Kinds {
			<a href={ templ.URL(t.URL) } hx-get={ t.URL } hx-target="#note-results" hx-push-url="true" class={ templ.KV("active", t.Active) }>
				{ t.Label } <span class="count">{ strconv.Itoa(t.Count) }</span>
			</a>
		}
	</nav>
	if len(v.Tabs) > 1 {
		<nav class="tabs" aria-label="Labels">
			for _, t := range v.Tabs {
				<a href={ templ.URL(t.URL) } hx-get={ t.URL } hx-target="#note-results" hx-push-url="true" class={ "tab", templ.KV("active", t.Active) }>
					{ t.Label } <span class="count">{ strconv.Itoa(t.Count) }</span>
				</a>
			}
		</nav>
	}
	if len(v.Notes) == 0 {
		<p class="empty">
			if v.Q != "" {
				No note matches “{ v.Q }”.
			} else if v.Label != "" {
				No notes labelled { v.Label }.
			} else {
				No notes yet.
			}
		</p>
	} else {
		<table class="list notes">
			<thead>
				<tr><th>Note</th><th>Written</th><th>By</th></tr>
			</thead>
			<tbody>
				for _, n := range v.Notes {
					<tr>
						<td data-label="Note">
							<div>
								<a href={ templ.URL("/notes/" + n.ID) }>
									@noteTitle(n, false)
								</a>
								if n.Kind != "" || n.Private {
									<div class="chips">
										@nodeTags(n.Fields)
									</div>
								}
								if len(n.Labels) > 0 {
									<div class="chips">
										@labelChips(v.Labels, n.Labels)
									</div>
								}
							</div>
						</td>
						<td data-label="Written" class="date">{ fmtNoteDate(n.Created) }</td>
						<td data-label="By">
							{ n.Author }
							if n.Via != "" {
								<span class="muted">via { n.Via }</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// noteTitle polls until a pending note has its title.
templ noteTitle(n notes.Note, reload bool) {
	if n.Pending {
		<span class="pending" hx-get={ noteTitleURL(n.ID, reload) } hx-trigger="every 2s" hx-swap="outerHTML">Generating title…</span>
	} else {
		<span>{ n.Title }</span>
	}
}

templ noteDetailPage(v noteView) {
	@layout(noteLabel(v.Note), v.Chrome) {
		<p class="back"><a href="/notes">← Notes</a></p>
		<article class="note">
			<h1>
				@noteTitle(v.Note, true)
			</h1>
			if v.Note.Kind != "" || v.Note.Private || len(v.Note.Labels) > 0 {
				<p class="chips">
					@nodeTags(v.Note.Fields)
					@labelChips(v.Labels, v.Note.Labels)
				</p>
			}
			@flashBox(v.Flash)
			<p class="sub">
				{ fmtNoteDate(v.Note.Created) } · { v.Note.Author }
				if v.Note.Via != "" {
					via { v.Note.Via }
				}
				if v.Note.EditedAt != "" {
					· edited by { v.Note.EditedBy }
				}
				if v.Note.Path != "" {
					· <code>{ v.Note.Path }</code>
				}
			</p>
			if !v.Note.Pending {
				<p class="note-actions"><a class="button" href={ templ.URL("/notes/" + v.Note.ID + "/edit") }>Edit</a></p>
			}
			<div class="body">
				@templ.Raw(v.BodyHTML)
			</div>
			if len(v.BasedOn) > 0 {
				<h2>Based on</h2>
				@refList(v.BasedOn)
			}
			if v.Note.IsNode() {
				<h2>Tasks for it</h2>
				if len(v.Tasks) == 0 {
					<p class="muted">None. On a task's page, set “For” to this { v.Note.Kind }.</p>
				} else {
					<ul class="node-tasks">
						for _, t := range v.Tasks {
							<li class={ templ.KV("done", t.T.Done) }>
								if t.T.Done {
									☑
								} else {
									☐
								}
								<a href={ templ.URL(t.URL) }>{ t.T.Summary }</a>
							</li>
						}
					</ul>
				}
			}
			if len(v.Leads) > 0 {
				<h2>Based on this</h2>
				@leadsList(v.Leads)
			}
			if !v.Note.Pending {
				<p><a class="button" href={ templ.URL("/notes?based_on=note:" + v.Note.ID + "#note-body") }>Add a goal or decision based on this</a></p>
			}
			if !v.Note.Pending {
				<form method="post" class="danger" action={ templ.URL("/notes/" + v.Note.ID + "/delete") }>
					<label class="check"><input type="checkbox" name="confirm" required/> Delete this note. It stays in git history.</label>
					<button type="submit">Delete</button>
				</form>
			}
		</article>
	}
}

templ noteForm(v noteFormView) {
	@layout("Edit note", v.Chrome) {
		<p class="back"><a href={ templ.URL("/notes/" + v.ID) }>← Back without saving</a></p>
		<h1>Edit note</h1>
		if v.Error != "" {
			@flashBox(flash{"error", v.Error})
		}
		<form method="post" class="settings wide" action={ templ.URL("/notes/" + v.ID) }>
			<label for="title">Title</label>
			<input id="title" name="title" type="text" value={ v.Title } required/>
			<label for="body">Note (Markdown)</label>
			<textarea id="body" name="body" rows="20" required data-ctrl-enter-submits>{ v.Body }</textarea>
			@labelPicker(v.Labels, v.Picked)
			@graphFields(v.Graph, false, "")
			<button type="submit" class="primary">Save</button>
		</form>
	}
}

templ aiSettingsPage(v aiView) {
	@layout("AI", v.Chrome) {
		<h1>AI</h1>
		<p class="lead">
			ktx uses <a href="https://neuralwatt.com">Neuralwatt</a> (<code>{ v.BaseURL }</code>) to write titles for notes.
			One key for the whole workspace; it's stored encrypted and never shown again.
		</p>
		@flashBox(v.Flash)
		if v.Status.Configured {
			<p>
				Using <code>{ v.Status.Model }</code> with key <code>{ v.Status.KeyHint }</code>,
				set by { v.Status.UpdatedBy } { ago(v.Status.UpdatedAt) }.
			</p>
		} else {
			<p class="muted">No key set: notes get their first line as title.</p>
		}
		if !v.CanStore {
			@flashBox(flash{"warn", "There's no master key on the server (BRAIN_MASTER_KEY_FILE), so an API key can't be stored."})
		} else if !v.CanEdit {
			<p class="muted">Only admins can change this.</p>
		} else {
			<form method="post" action="/settings/ai" class="settings">
				<label for="key">API key</label>
				<input id="key" name="key" type="password" autocomplete="off" placeholder={ keyPlaceholder(v) } required?={ !v.Status.Configured }/>
				<label for="model">Model</label>
				<input id="model" name="model" type="text" value={ v.Model } autocomplete="off" spellcheck="false"/>
				<p class="help"><code>nw-flash</code> follows Neuralwatt's current fast model. Saving checks the key and model with a test title.</p>
				<button type="submit" class="primary">Save</button>
			</form>
			if v.Status.Configured {
				<form method="post" action="/settings/ai" class="danger">
					<input type="hidden" name="remove" value="1"/>
					<span>Remove the key; titles then come from the first line.</span>
					<button type="submit">Remove</button>
				</form>
			}
		}
	}
}

// labelChips shows a note's labels, linking to the notes with each.
templ labelChips(defs []notes.Label, labels []string) {
	for _, l := range labels {
		<a class="label" href={ templ.URL(notesURL("", l)) } title={ labelMeaning(defs, l) }>{ l }</a>
	}
}

// labelPicker is a checkbox per label, with its meaning.
templ labelPicker(defs []notes.Label, picked []string) {
	if len(defs) > 0 {
		<fieldset class="labels">
			<legend>Labels</legend>
			for _, d := range defs {
				<label class="check" title={ d.Description }>
					<input type="checkbox" name="labels" value={ d.Name } checked?={ slices.Contains(picked, d.Name) }/>
					<span class="label">{ d.Name }</span>
					<span class="help">{ d.Description }</span>
				</label>
			}
		</fieldset>
	} else {
		<p class="help"><a href="/settings/labels">Define labels</a> to sort notes (e.g. one for pasted AI output).</p>
	}
}

templ labelsSettingsPage(v labelsView) {
	@layout("Labels", v.Chrome) {
		<h1>Labels</h1>
		<p class="lead">
			Labels for notes, and what each means. People tick them when writing a note; the AI adds the ones whose meaning fits;
			agents see the list over MCP. Stored in <code>notes/labels.yaml</code>.
		</p>
		@flashBox(v.Flash)
		if len(v.Labels) > 0 {
			<table class="list">
				<thead>
					<tr><th>Label</th><th>Meaning</th><th>Notes</th><th></th></tr>
				</thead>
				<tbody>
					for _, l := range v.Labels {
						<tr>
							<td data-label="Label"><a class="label" href={ templ.URL(notesURL("", l.Name)) }>{ l.Name }</a></td>
							<td data-label="Meaning">
								<form method="post" action="/settings/labels" class="meaning">
									<input type="hidden" name="name" value={ l.Name }/>
									<textarea name="description" rows="3" aria-label={ "Meaning of " + l.Name } required>{ l.Description }</textarea>
									<button type="submit">Save</button>
								</form>
							</td>
							<td data-label="Notes">{ strconv.Itoa(l.Count) }</td>
							<td class="actions">
								if l.Count == 0 {
									<form method="post" action={ templ.URL("/settings/labels/" + l.Name + "/delete") }>
										<button type="submit">Delete</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<form method="post" action="/settings/labels" class="settings">
			<label for="label-name">New label</label>
			<input id="label-name" name="name" type="text" value={ v.Name } placeholder="e.g. slop" pattern="[a-z0-9][a-z0-9_\-]{0,29}" autocomplete="off" required/>
			<p class="help">Lowercase letters, digits, - and _.</p>
			<label for="label-description">What it means</label>
			<textarea id="label-description" name="description" rows="2" placeholder="e.g. Pasted AI output, not reviewed; don't trust it as fact" required>{ v.Description }</textarea>
			<button type="submit" class="primary">Add label</button>
		</form>
	}
}
