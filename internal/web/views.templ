package web

import (
	"strconv"
	"strings"
)

templ layout(title string, c chrome) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · brain</title>
			<link rel="stylesheet" href={ c.Assets.CSS }/>
			<script src={ c.Assets.HTMX } defer></script>
			<script src={ c.Assets.JS } defer></script>
		</head>
		<body>
			<header class="top">
				<a class="brand" href="/">brain</a>
				<nav>
					<a href="/" class={ templ.KV("active", c.Nav == "transcripts") }>Transcripts</a>
					if c.Notes {
						<a href="/notes" class={ templ.KV("active", c.Nav == "notes") }>Notes</a>
					}
					if c.Agenda {
						<a href="/agenda" class={ templ.KV("active", c.Nav == "agenda") }>Calendar</a>
						<a href="/tasks" class={ templ.KV("active", c.Nav == "tasks") }>Tasks</a>
					}
					if c.HasSettings() {
						<a href="/settings" class={ templ.KV("active", c.InSettings()) }>Settings</a>
					}
				</nav>
				if c.User != "" {
					<form class="account" method="post" action="/auth/logout">
						<span class="user">
							{ c.User }
							if c.IsAdmin {
								<span class="badge">admin</span>
							}
						</span>
						<button type="submit" class="link">Sign out</button>
					</form>
				}
			</header>
			<main>
				if c.InSettings() {
					<nav class="tabs settings-tabs" aria-label="Settings">
						if c.General {
							<a href="/settings/general" class={ "tab", templ.KV("active", c.Nav == "general") }>General</a>
						}
						if c.Connections {
							<a href="/settings/connections" class={ "tab", templ.KV("active", c.Nav == "connections") }>Connections</a>
						}
						if c.Calendar {
							<a href="/settings/calendar" class={ "tab", templ.KV("active", c.Nav == "calendar") }>Calendar</a>
						}
						if c.Tokens {
							<a href="/settings/tokens" class={ "tab", templ.KV("active", c.Nav == "tokens") }>Tokens</a>
						}
						if c.Labels {
							<a href="/settings/labels" class={ "tab", templ.KV("active", c.Nav == "labels") }>Labels</a>
						}
						if c.AI {
							<a href="/settings/ai" class={ "tab", templ.KV("active", c.Nav == "ai") }>AI</a>
						}
					</nav>
				}
				{ children... }
			</main>
		</body>
	</html>
}

templ flashBox(f flash) {
	if f.Text != "" {
		<p class={ "flash", f.Kind } role="status">{ f.Text }</p>
	}
}

templ errorPage(c chrome, msg string) {
	@layout("Error", c) {
		@flashBox(flash{"error", msg})
		<p><a href="/">Back to transcripts</a></p>
	}
}

templ listPage(v listView) {
	@layout("Transcripts", v.Chrome) {
		<form id="filters" class="filters" action="/" method="get" hx-get="/" hx-target="#results" hx-push-url="true" hx-trigger="input delay:300ms, submit">
			<input class="filter-field" type="search" name="q" value={ v.Q } placeholder="Search titles, people, tags, text…" aria-label="Search" autocomplete="off"/>
			<select class="filter-field" name="sort" aria-label="Sort">
				for _, o := range sortOptions {
					<option value={ o.Value } selected?={ o.Value == v.Sort }>{ o.Label }</option>
				}
			</select>
		</form>
		<div id="results">
			@results(v)
		</div>
	}
}

templ typeDatalist(types []string) {
	<datalist id="type-options">
		for _, t := range types {
			<option value={ t }></option>
		}
	</datalist>
}

templ results(v listView) {
	<input class="filter-field" type="hidden" name="folder" value={ v.Folder } form="filters"/>
	@flashBox(v.Flash)
	<nav class="tabs">
		for _, t := range v.Tabs {
			<a href={ templ.URL(t.URL) } hx-get={ t.URL } hx-target="#results" hx-push-url="true" class={ "tab", templ.KV("active", t.Active) }>
				{ t.Label } <span class="count">{ strconv.Itoa(t.Count) }</span>
			</a>
		}
		<a class="button sort-next" href="/transcripts/new">New transcript</a>
	</nav>
	@typeDatalist(v.Types)
	if len(v.Entries) == 0 {
		<p class="empty">
			if v.Q != "" {
				Nothing matches “{ v.Q }”.
			} else if v.Folder == "unsorted" {
				Nothing left to sort.
			} else {
				No transcripts yet.
			}
		</p>
	} else {
		<form id="bulk" class="bulk" method="post" action="/transcripts/type" hx-post="/transcripts/type" hx-target="#results" hx-sync="this:drop">
			<input type="hidden" name="q" value={ v.Q }/>
			<input type="hidden" name="folder" value={ v.Folder }/>
			<input type="hidden" name="sort" value={ v.Sort }/>
			<label for="bulk-type">Set type of selected</label>
			<input id="bulk-type" type="text" name="type" list="type-options" placeholder="e.g. customer_discovery" autocomplete="off" required/>
			<button type="submit">Apply</button>
			<span class="muted" data-selected-count></span>
		</form>
		<table class="transcripts">
			<thead>
				<tr>
					<th class="pick"><input type="checkbox" data-select-all="bulk-ids" aria-label="Select all shown"/></th>
					<th>Date</th><th>Conversation</th><th>Participants</th><th>Type</th>
				</tr>
			</thead>
			<tbody>
				for _, e := range v.Entries {
					<tr>
						<td class="pick">
							if e.ID != "" {
								<input type="checkbox" name="ids" value={ e.ID } form="bulk" data-group="bulk-ids" aria-label={ "Select " + e.Label() }/>
							}
						</td>
						<td class="date">{ fmtDate(e) }</td>
						<td>
							if e.ID != "" {
								<a href={ templ.URL("/transcripts/" + e.ID) }>{ e.Label() }</a>
							} else {
								{ e.Label() }
							}
							if len(e.Problems) > 0 {
								<span class="badge warn" title={ strings.Join(e.Problems, "\n") }>check</span>
							}
							if e.Meta.Source != "" || len(e.Meta.Tags) > 0 {
								<div class="sub">
									{ e.Meta.Source }
									for _, tag := range e.Meta.Tags {
										<span class="tag">{ tag }</span>
									}
								</div>
							}
						</td>
						<td class="people">{ participantSummary(e) }</td>
						<td class="type">
							if e.ID != "" {
								<input type="text" name="type" list="type-options" value={ typeValue(e) } placeholder="unsorted" aria-label={ "Type of " + e.Label() } autocomplete="off" hx-post={ "/transcripts/" + e.ID + "/type" } data-enter-commits hx-trigger="change" hx-sync="this:drop" hx-target="#results" hx-include=".filter-field"/>
							} else {
								{ e.Folder }
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ detailPage(v detailView) {
	@layout(v.Entry.Label(), v.Chrome) {
		<p class="back"><a href={ templ.URL(v.BackURL) }>← { v.BackLabel }</a></p>
		<article class="transcript">
			<h1>{ v.Entry.Label() }</h1>
			@flashBox(v.Flash)
			if len(v.Entry.Problems) > 0 {
				<div class="flash warn">
					This file doesn't meet the upload rules:
					<ul>
						for _, p := range v.Entry.Problems {
							<li>{ p }</li>
						}
					</ul>
				</div>
			}
			if v.Entry.ID != "" {
				<div class="retype">
					<form method="post" action={ templ.URL("/transcripts/" + v.Entry.ID + "/type") }>
						<label for="type">Type</label>
						<input id="type" type="text" name="type" list="type-options" value={ typeValue(v.Entry) } placeholder="unsorted" autocomplete="off"/>
						@typeDatalist(v.Types)
						<button type="submit">Save</button>
					</form>
					<a class="button" href={ templ.URL("/transcripts/" + v.Entry.ID + "/edit") }>Edit</a>
				</div>
			}
			<dl class="meta">
				<dt>When</dt>
				<dd>
					{ fmtDate(v.Entry) }
					if own := ownTime(v.Entry); own != "" {
						<span class="muted">({ own })</span>
					}
					if v.Entry.Meta.DurationMinutes > 0 {
						· { strconv.Itoa(v.Entry.Meta.DurationMinutes) } min
					}
				</dd>
				<dt>Participants</dt>
				<dd>
					<ul class="plain">
						for _, p := range v.Entry.Meta.Participants {
							<li>
								{ participantLine(p) }
								if p.Email != "" {
									<a href={ templ.URL("mailto:" + p.Email) }>{ p.Email }</a>
								}
								if p.From == "calendar" {
									<span class="muted">from the event</span>
								}
							</li>
						}
					</ul>
				</dd>
				if v.Events != nil {
					@eventBlock(v)
				}
				if v.Entry.Meta.Source != "" {
					<dt>Source</dt>
					<dd>
						{ v.Entry.Meta.Source }
						if v.Entry.Meta.SourceID != "" {
							<code>{ v.Entry.Meta.SourceID }</code>
						}
					</dd>
				}
				if len(v.Entry.Meta.Tags) > 0 {
					<dt>Tags</dt>
					<dd>
						for _, tag := range v.Entry.Meta.Tags {
							<span class="tag">{ tag }</span>
						}
					</dd>
				}
				<dt>Stored</dt>
				<dd>
					<code>{ v.Entry.Path }</code>
					if v.Entry.UploadedBy != "" {
						· uploaded by { v.Entry.UploadedBy }
					}
					if v.Entry.IngestedAt != "" {
						· first ingested { v.Entry.IngestedAt }
					}
					if v.Entry.EditedAt != "" {
						· edited by { v.Entry.EditedBy } { v.Entry.EditedAt }
						if v.Entry.Meta.Source != "" && v.Entry.Meta.Source != "manual" {
							(no longer updated from { v.Entry.Meta.Source })
						}
					}
				</dd>
			</dl>
			<div class="body">
				@templ.Raw(v.BodyHTML)
			</div>
			if v.Entry.ID != "" {
				<form method="post" class="danger" action={ templ.URL("/transcripts/" + v.Entry.ID + "/delete") }>
					<label class="check"><input type="checkbox" name="confirm"/> Delete this transcript. It stays in git history; connector syncs won't bring it back.</label>
					<button type="submit">Delete</button>
				</form>
			}
		</article>
	}
}

templ signInFailed(c chrome, msg string) {
	@layout("Sign-in failed", c) {
		<section class="narrow">
			<h1>Sign-in failed</h1>
			@flashBox(flash{"error", msg})
			<p><a class="button primary" href="/auth/login">Try again</a></p>
		</section>
	}
}

templ signedOutPage(c chrome) {
	@layout("Signed out", c) {
		<section class="narrow">
			<h1>Signed out</h1>
			<p>You're signed out of ktx. You may still be signed in to the identity provider.</p>
			<p><a class="button primary" href="/auth/login">Sign in again</a></p>
		</section>
	}
}

templ transcriptForm(v formView) {
	@layout(formTitle(v), v.Chrome) {
		if v.ID != "" {
			<p class="back"><a href={ templ.URL("/transcripts/" + v.ID) }>← Back without saving</a></p>
		} else {
			<p class="back"><a href="/">← Transcripts</a></p>
		}
		<h1>{ formTitle(v) }</h1>
		if v.Source != "" && v.Source != "manual" {
			<p class="flash warn">Synced from { v.Source }. Once you save an edit here, syncs from { v.Source } stop updating this transcript; changes made there afterwards won't come through.</p>
		}
		if len(v.Problems) > 0 {
			<div class="flash error" role="alert">
				<ul>
					for _, p := range v.Problems {
						<li>{ p }</li>
					}
				</ul>
			</div>
		}
		<form method="post" class="settings wide" action={ formURL(v) }>
			<label for="title">Title</label>
			<input id="title" name="title" type="text" value={ v.Title } required placeholder="Intro call with Acme"/>
			<div class="row">
				<div>
					<label for="date">Date and time</label>
					<input id="date" name="date" type="datetime-local" value={ v.Date } required/>
				</div>
				<div>
					<label for="timezone">Time zone</label>
					<input id="timezone" name="timezone" type="text" value={ v.Timezone } list="zones" required placeholder="America/Los_Angeles" autocomplete="off" if v.NewForm { data-default-timezone }/>
					<datalist id="zones">
						for _, z := range commonZones {
							<option value={ z }></option>
						}
					</datalist>
				</div>
				<div>
					<label for="duration">Duration (min)</label>
					<input id="duration" name="duration" type="number" min="0" value={ v.Duration }/>
				</div>
				<div>
					<label for="ftype">Type</label>
					<input id="ftype" name="type" type="text" list="type-options" value={ v.Type } placeholder="unsorted" autocomplete="off"/>
					@typeDatalist(v.Types)
				</div>
			</div>
			<label for="participants">Participants</label>
			<textarea id="participants" name="participants" rows="4" spellcheck="false" placeholder="Jane Doe <jane@acme.com> | Acme | CTO">{ v.Participants }</textarea>
			<p class="help">One per line: <code>Name &lt;email&gt; | Company | Role</code>. Email, company and role are optional.</p>
			<label for="tags">Tags</label>
			<input id="tags" name="tags" type="text" value={ v.Tags } placeholder="pricing, multi-tenant"/>
			<label for="body">Transcript or notes (Markdown)</label>
			<textarea id="body" name="body" rows="24" class="mono" required>{ v.Body }</textarea>
			<button type="submit" class="primary">
				if v.ID == "" {
					Add transcript
				} else {
					Save
				}
			</button>
		</form>
	}
}
