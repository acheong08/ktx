package web

import (
	"strconv"

	"github.com/acheong08/ktx/internal/calendar"
	"strings"
)

templ calendarPage(v calendarView) {
	@layout("Calendar", v.Chrome) {
		<h1>Calendar</h1>
		<p class="lead">
			Calls are linked to the event they were recorded in, by time, and get the event's guests as participants.
			Everyone can see every calendar; only the owner can change one.
		</p>
		@flashBox(v.Flash)
		if v.Report != nil {
			<div class="flash ok">
				<p>
					Import into { v.Into }: { strconv.Itoa(v.Report.Added) } added, { strconv.Itoa(v.Report.Updated) } updated,
					{ strconv.Itoa(v.Report.Unchanged) } unchanged, { strconv.Itoa(len(v.Report.Skipped)) } skipped.
				</p>
				if len(v.Report.Skipped) > 0 {
					<details>
						<summary>Skipped</summary>
						<ul>
							for _, s := range v.Report.Skipped {
								<li>{ s }</li>
							}
						</ul>
					</details>
				}
				if len(v.Report.Warnings) > 0 {
					<details>
						<summary>Warnings</summary>
						<ul>
							for _, s := range v.Report.Warnings {
								<li>{ s }</li>
							}
						</ul>
					</details>
				}
			</div>
		}
		<h2>Calendars</h2>
		<table class="list">
			<thead>
				<tr><th>Calendar</th><th>Owner</th><th>Events</th><th>Tasks</th><th>CalDAV path</th></tr>
			</thead>
			<tbody>
				for _, c := range v.Calendars {
					<tr>
						<td data-label="Calendar">
							if c.Mine {
								<form method="post" action={ templ.URL("/settings/calendar/" + c.Cal.ID) } class="rename">
									<input type="text" name="name" value={ c.Cal.Title() } aria-label={ "Name of " + c.Cal.ID } maxlength="200" required/>
									<button type="submit">Rename</button>
								</form>
							} else {
								{ c.Cal.Title() }
							}
						</td>
						<td data-label="Owner">
							{ c.Cal.Owner }
							if c.Cal.Subscribed() {
								<span class="badge">subscription</span>
							}
							for _, n := range v.mergedNames(c.Cal.ID) {
								<span class="badge">+ { n }</span>
							}
							if !c.Mine {
								<span class="muted">(read-only for you)</span>
							}
						</td>
						<td data-label="Events">{ strconv.Itoa(c.Events) }</td>
						<td data-label="Tasks">{ strconv.Itoa(c.Tasks) }</td>
						<td data-label="CalDAV path"><code>{ davPath(v.Owner, c.Cal.Owner, c.Cal.ID) }</code></td>
					</tr>
				}
			</tbody>
		</table>
		if v.Feeds {
			@subscriptions(v)
		}
		<div class="columns">
			<form method="post" action="/settings/calendar/import" enctype="multipart/form-data" class="settings">
				<h3>Import an .ics file</h3>
				<p class="muted">An export from Google Calendar, Apple Calendar, Outlook or a task app. Events and tasks (to-dos) are added or updated by UID; nothing is deleted, so importing again is safe.</p>
				<label for="import-cal">Into</label>
				<select id="import-cal" name="calendar">
					for _, c := range v.Mine {
						<option value={ c.ID }>{ c.Title() }</option>
					}
				</select>
				<label for="import-file">File</label>
				<input id="import-file" type="file" name="file" accept=".ics,text/calendar" required/>
				<button type="submit" class="primary">Import</button>
			</form>
			<form method="post" action="/settings/calendar" class="settings">
				<h3>New calendar</h3>
				<label for="cal-id">Id</label>
				<input id="cal-id" name="id" type="text" value={ v.NewID } placeholder="e.g. work" pattern="[a-z0-9][a-z0-9_\-]*" required/>
				<label for="cal-name">Name</label>
				<input id="cal-name" name="name" type="text" value={ v.NewName } placeholder="e.g. Work"/>
				<button type="submit">Create</button>
			</form>
		</div>
		<h2>Connect a calendar app</h2>
		<p>
			Create a <a href="/settings/tokens#calendar">calendar token</a>, then sign in with your ktx username
			(<code>{ v.Owner }</code>) and the token as the password. Works while you're on the tailnet.
		</p>
		<ul>
			<li><strong>iPhone:</strong> Settings → Apps → Calendar → Calendar Accounts → Add Account → Other → Add CalDAV Account. Server <code>{ strings.TrimSuffix(strings.TrimPrefix(v.DAVURL, "https://"), "/dav/") }</code>.</li>
			<li><strong>Thunderbird:</strong> New Calendar → On the Network. Location <code>{ v.DAVURL }</code>, then pick the calendars to show.</li>
		</ul>
		<p>Events and tasks are on the <a href="/agenda">Calendar</a> and <a href="/tasks">Tasks</a> pages.</p>
	}
}

templ eventBlock(v detailView) {
	<dt>Calendar event</dt>
	<dd>
		if l := v.Entry.Meta.CalendarEvent; l != nil && l.UID != "" {
			{ l.Title } · { eventWhen(l) } · <span class="muted">{ l.Calendar }, { matchLabel(l.Match) }</span>
		} else if l != nil && l.Match == "none" {
			<span class="muted">none ({ matchLabel(l.Match) })</span>
		} else {
			<span class="muted">none found</span>
		}
		<form method="post" class="inline" action={ templ.URL("/transcripts/" + v.Entry.ID + "/event") }>
			<select name="event" aria-label="Calendar event">
				for _, c := range v.Events {
					<option value={ c.Value } selected?={ c.Selected }>{ c.Label }</option>
				}
			</select>
			<button type="submit">Set</button>
		</form>
	</dd>
}

templ subscriptions(v calendarView) {
	<h2 id="subscriptions">Subscriptions</h2>
	<p class="lead">
		An iCal link (Luma's “Calendar Syncing”, a Google or Outlook calendar's secret address), refreshed every 30 minutes.
		Show its events in one of your calendars (one calendar in your apps; its events can't be edited there), or as a read-only calendar of its own. Only the calendar is in git; the link holds a secret, so it's stored encrypted on the server.
	</p>
	for _, c := range v.Subs {
		<div class="subscription">
			<h3>{ c.Cal.Title() } <code>{ c.Cal.ID }</code></h3>
			if c.Feed.NeedsURL {
				@flashBox(flash{"warn", "The link for this subscription isn't stored on this server any more. Paste it again below."})
			} else {
				<p class="sub">
					{ c.Feed.URLHint } · { itemCount(c.Feed.Items) } · fetched { ago(c.Feed.FetchedAt) }
					if c.Into != "" {
						· shown in { c.Into }
					}
				</p>
				if c.Feed.Error != "" {
					@flashBox(flash{"error", "Last fetch failed (" + ago(c.Feed.CheckedAt) + "): " + c.Feed.Error + ". The last copy is still shown."})
				}
			}
			<div class="buttons-row">
				if !c.Feed.NeedsURL {
					<form method="post" action={ templ.URL("/settings/calendar/" + c.Cal.ID + "/refresh") }>
						<button type="submit">Refresh now</button>
					</form>
				}
				<form method="post" action={ templ.URL("/settings/calendar/" + c.Cal.ID + "/merge") } class="rename">
					@intoSelect(v.Mine, c.Cal.MergedInto(), "Show "+c.Cal.Title()+" as")
					<button type="submit">Save</button>
				</form>
				<details>
					<summary>Change link</summary>
					<form method="post" action="/settings/calendar/subscribe" class="settings">
						<input type="hidden" name="id" value={ c.Cal.ID }/>
						<input type="hidden" name="name" value={ c.Cal.Title() }/>
						<label for={ "url-" + c.Cal.ID }>iCal link</label>
						<input id={ "url-" + c.Cal.ID } name="url" type="url" placeholder="https://… or webcal://…" autocomplete="off" required/>
						<button type="submit">Save link</button>
					</form>
				</details>
			</div>
			<form method="post" action={ templ.URL("/settings/calendar/" + c.Cal.ID + "/unsubscribe") } class="danger">
				<label class="check"><input type="checkbox" name="confirm" required/> Remove this subscription.</label>
				<button type="submit">Remove</button>
			</form>
		</div>
	}
	if v.CanSeal {
		<form method="post" action="/settings/calendar/subscribe" class="settings">
			<h3>Subscribe to a calendar</h3>
			<label for="sub-name">Name</label>
			<input id="sub-name" name="name" type="text" value={ v.SubName } placeholder="e.g. Luma" required/>
			<label for="sub-url">iCal link</label>
			<input id="sub-url" name="url" type="url" value={ v.SubURL } placeholder="https://… or webcal://…" autocomplete="off" required/>
			<label for="sub-into">Show</label>
			@intoSelect(v.Mine, v.SubInto, "")
			<p class="help">On Luma: Settings → Calendar Syncing → Add iCal Subscription, then copy the link. The link is checked before anything is saved.</p>
			<button type="submit" class="primary">Subscribe</button>
		</form>
	} else {
		@flashBox(flash{"warn", "There's no master key on the server (BRAIN_MASTER_KEY_FILE), so subscription links can't be stored."})
	}
}

// intoSelect picks where a subscription's events show: as part of one of
// my calendars, or as a calendar of their own.
templ intoSelect(mine []calendar.Calendar, current, ariaLabel string) {
	<select name="into" if ariaLabel != "" {
	aria-label={ ariaLabel }
} else {
	id="sub-into"
}>
		for _, m := range mine {
			<option value={ m.ID } selected?={ m.ID == current }>In { m.Title() }</option>
		}
		<option value="" selected?={ current == "" }>As its own calendar</option>
	</select>
}
