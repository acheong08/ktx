package web

import "github.com/acheong08/ktx/internal/state"

import "github.com/acheong08/ktx/internal/calendar"

import "strconv"

templ connectionsPage(v connectionsView) {
	@layout("Connections", v.Chrome) {
		<h1>Connections</h1>
		<p class="lead">Services ktx pulls documents from on a schedule. Each connection uses one person's credential; it is stored encrypted and never shown again.</p>
		@flashBox(v.Flash)
		if v.NoKey {
			@flashBox(flash{"warn", "No master key is configured, so credentials can't be stored and connections don't run. See BRAIN_MASTER_KEY_FILE in the README."})
		}
		@connectionsTable(v)
		<h2>Add a connection</h2>
		<ul class="kinds">
			for _, k := range v.Kinds {
				<li>
					<a class="button" href={ templ.URL("/settings/connections/new?kind=" + k.Kind()) }>{ k.Title() }</a>
					<span class="muted">{ k.Description() }</span>
				</li>
			}
		</ul>
	}
}

templ connectionsTable(v connectionsView) {
	<div id="connections" if v.Polling { hx-get="/settings/connections" hx-trigger="every 3s" hx-target="this" hx-swap="outerHTML" }>
		if len(v.Rows) == 0 {
			<p class="empty">No connections yet.</p>
		} else {
			<table class="list">
				<thead>
					<tr><th>Name</th><th>Service</th><th>Owner</th><th>Last sync</th><th></th></tr>
				</thead>
				<tbody>
					for _, row := range v.Rows {
						<tr>
							<td data-label="Name">
								<a href={ templ.URL("/settings/connections/" + strconv.FormatInt(row.Conn.ID, 10)) }>{ row.Conn.Label }</a>
								if !row.Conn.Enabled {
									<span class="badge">disabled</span>
								}
								if row.Conn.Account != "" {
									<div class="sub">{ row.Conn.Account }</div>
								}
							</td>
							<td data-label="Service">{ row.Title }</td>
							<td data-label="Owner">{ row.Conn.Owner }</td>
							<td data-label="Last sync">
								if row.Syncing {
									<span class="badge ok">syncing…</span>
								} else if row.Last != nil {
									{ ago(row.Last.StartedAt) } · { runSummary(*row.Last) }
									if row.Last.Error != "" {
										<div class="sub error-text">{ row.Last.Error }</div>
									}
								} else {
									<span class="muted">not yet</span>
								}
							</td>
							<td class="actions">
								if row.Conn.Enabled && !v.NoKey {
									<form method="post" action={ templ.URL("/settings/connections/" + strconv.FormatInt(row.Conn.ID, 10) + "/sync") }>
										<button type="submit" disabled?={ row.Syncing }>Sync now</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

templ connectionFormPage(v connFormView) {
	@layout(v.Label, v.Chrome) {
		<p class="back"><a href="/settings/connections">← Connections</a></p>
		if v.Conn == nil {
			<h1>Add { v.Kind.Title() }</h1>
		} else {
			<h1>{ v.Conn.Label }</h1>
		}
		<p class="lead">{ v.Kind.Description() }</p>
		@flashBox(v.Flash)
		if len(v.Problems) > 0 {
			<div class="flash error" role="alert">
				<ul>
					for _, p := range v.Problems {
						<li>{ p }</li>
					}
				</ul>
			</div>
		}
		if v.Conn != nil {
			<dl class="meta">
				<dt>Owner</dt>
				<dd>{ v.Conn.Owner }</dd>
				if v.Conn.Account != "" {
					<dt>Account</dt>
					<dd>{ v.Conn.Account }</dd>
				}
				<dt>Bookmark</dt>
				<dd>
					if v.Conn.Cursor != "" {
						<code>{ v.Conn.Cursor }</code>
					} else {
						<span class="muted">none yet: the first sync fetches everything</span>
					}
				</dd>
			</dl>
			if v.Conn.Enabled {
				<form method="post" action={ templ.URL("/settings/connections/" + strconv.FormatInt(v.Conn.ID, 10) + "/sync") } class="inline">
					<input type="hidden" name="back" value="detail"/>
					<button type="submit" class="primary" disabled?={ v.Syncing }>
						if v.Syncing {
							Syncing…
						} else {
							Sync now
						}
					</button>
				</form>
			}
		}
		if v.CanEdit {
			<form method="post" class="settings" action={ formAction(v) }>
				if v.Conn == nil {
					<input type="hidden" name="kind" value={ v.Kind.Kind() }/>
				}
				<label for="label">Name</label>
				<input id="label" name="label" type="text" value={ v.Label } required/>
				for _, f := range v.Kind.Fields() {
					<label for={ "field_" + f.Name }>
						{ f.Label }
						if f.Required {
							<span class="muted">(required)</span>
						}
					</label>
					if f.Secret {
						<input id={ "field_" + f.Name } name={ "field_" + f.Name } type="password" autocomplete="off" spellcheck="false" placeholder={ secretPlaceholder(v, f.Placeholder) }/>
					} else {
						<input id={ "field_" + f.Name } name={ "field_" + f.Name } type="text" value={ v.Values[f.Name] } placeholder={ f.Placeholder } spellcheck="false"/>
					}
					if f.Help != "" {
						<p class="help">{ f.Help }</p>
					}
				}
				if v.Conn != nil {
					<label class="check"><input type="checkbox" name="enabled" checked?={ v.Enabled }/> Enabled (syncs every { v.Kind.Interval().String() })</label>
				}
				<button type="submit" class="primary">
					if v.Conn == nil && v.SignIn {
						Sign in to { v.Kind.Title() }
					} else if v.Conn == nil {
						Check and add
					} else {
						Save
					}
				</button>
			</form>
			if v.Conn != nil && v.SignIn {
				<form method="post" action={ templ.URL("/settings/connections/" + strconv.FormatInt(v.Conn.ID, 10) + "/signin") } class="settings">
					<p class="help">If syncs fail with “sign in again”, or to switch accounts:</p>
					<button type="submit">Sign in again</button>
				</form>
			}
		}
		if v.Conn != nil {
			<h2>Recent syncs</h2>
			if len(v.Runs) == 0 {
				<p class="muted">None yet.</p>
			} else {
				<table class="list">
					<thead>
						<tr><th>Started</th><th>Trigger</th><th>Result</th><th>Commit</th></tr>
					</thead>
					<tbody>
						for _, r := range v.Runs {
							<tr>
								<td data-label="Started">{ ago(r.StartedAt) }</td>
								<td data-label="Trigger">{ r.Trigger }</td>
								<td data-label="Result">
									{ runSummary(r) }
									if r.Error != "" {
										<div class="sub error-text">{ r.Error }</div>
									}
								</td>
								<td data-label="Commit"><code>{ shortSHA(r.Commit) }</code></td>
							</tr>
						}
					</tbody>
				</table>
			}
			if v.CanEdit {
				<form method="post" class="danger" action={ templ.URL("/settings/connections/" + strconv.FormatInt(v.Conn.ID, 10) + "/delete") }>
					<label class="check"><input type="checkbox" name="confirm"/> Delete this connection. Documents it already stored stay in git.</label>
					<button type="submit">Delete</button>
				</form>
			}
		}
	}
}

templ tokensPage(v tokensView) {
	@layout("Tokens", v.Chrome) {
		<h1>Tokens</h1>
		<h2 id="api">API tokens</h2>
		<p class="lead">For scripts that upload transcripts (<code>POST /v1/transcripts</code> with <code>Authorization: Bearer …</code>). Uploads are attributed to you.</p>
		@tokenSection(v, "api", v.Tokens, "e.g. granola import script")
		if v.Calendar {
			<h2 id="calendar">Calendar tokens</h2>
			<p class="lead">
				For calendar apps (CalDAV). Sign in with username <code>{ v.Username }</code> and a token as the password;
				server <code>{ v.DAVURL }</code>. A calendar token only works for calendars, and only as you.
			</p>
			@tokenSection(v, "caldav", v.CalTokens, "e.g. iPhone")
		}
		if v.MCP {
			<h2 id="apps">Connected apps</h2>
			<p class="lead">
				AI agents and other MCP clients can read every transcript, note and calendar as you, and write notes (always labelled slop).
				Add the MCP server <code>{ v.MCPURL }</code> to the app; it will ask you to allow it here.
			</p>
			if len(v.Apps) > 0 {
				<table class="list">
					<thead>
						<tr><th>App</th><th>Allowed</th><th>Last used</th><th></th></tr>
					</thead>
					<tbody>
						for _, a := range v.Apps {
							<tr>
								<td data-label="App">{ a.ClientName }</td>
								<td data-label="Allowed">{ ago(a.CreatedAt) }</td>
								<td data-label="Last used">{ ago(a.LastUsedAt) }</td>
								<td class="actions">
									<form method="post" action={ templ.URL("/settings/apps/" + strconv.FormatInt(a.ID, 10) + "/delete") }>
										<button type="submit">Revoke</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			} else {
				<p class="muted">No apps connected.</p>
			}
		}
	}
}

templ authorizePage(v authorizeView) {
	@layout("Allow app", v.Chrome) {
		<section class="narrow">
			<h1>Allow “{ v.App }”?</h1>
			<p>
				It will be able to <strong>read every transcript, note and calendar in ktx</strong> as { v.Chrome.User },
				and <strong>write notes</strong>, which are always labelled slop. It can't change or delete anything.
				Every request it makes says why, and is logged.
			</p>
			<p>Afterwards you'll be sent to <code>{ v.Destination }</code>. Only allow it if you just started connecting this app.</p>
			<p class="muted">You can revoke it any time under Settings → Tokens.</p>
			<form method="post" action="/oauth/authorize" class="buttons">
				<input type="hidden" name="request" value={ v.Request }/>
				<button type="submit" name="decision" value="allow" class="primary">Allow</button>
				<button type="submit" name="decision" value="deny">Cancel</button>
			</form>
		</section>
	}
}

templ tokenSection(v tokensView, scope string, toks []state.APIToken, placeholder string) {
	if v.New != "" && v.NewScope == scope {
		<div class="flash ok">
			<p>Token “{ v.Name }” created. Copy it now; it won't be shown again.</p>
			<div class="command">
				<pre id={ "new-token-" + scope }>{ v.New }</pre>
				<button type="button" data-copy={ "#new-token-" + scope }>Copy</button>
			</div>
		</div>
	}
	if v.Error != "" && v.ErrScope == scope {
		@flashBox(flash{"error", v.Error})
	}
	if len(toks) > 0 {
		<table class="list">
			<thead>
				<tr><th>Name</th><th>Created</th><th>Last used</th><th></th></tr>
			</thead>
			<tbody>
				for _, t := range toks {
					<tr>
						<td data-label="Name">{ t.Name }</td>
						<td data-label="Created">{ ago(t.CreatedAt) }</td>
						<td data-label="Last used">{ ago(t.LastUsedAt) }</td>
						<td class="actions">
							<form method="post" action={ templ.URL("/settings/tokens/" + strconv.FormatInt(t.ID, 10) + "/delete") }>
								<button type="submit">Revoke</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
	<form method="post" action="/settings/tokens" class="settings">
		<input type="hidden" name="scope" value={ scope }/>
		<label for={ "name-" + scope }>New token</label>
		<input id={ "name-" + scope } name="name" type="text" placeholder={ placeholder } required/>
		<button type="submit" class="primary">Create token</button>
	</form>
}

templ generalPage(v generalView) {
	@layout("General", v.Chrome) {
		<h1>General</h1>
		@flashBox(v.Flash)
		<form method="post" action="/settings/general" class="settings">
			<label for="timezone">Time zone</label>
			<input id="timezone" name="timezone" type="text" value={ v.Zone } list="zones" autocomplete="off" spellcheck="false" required/>
			<datalist id="zones">
				for _, z := range v.Zones {
					<option value={ z }></option>
				}
			</datalist>
			<p class="help">
				For the whole workspace: times in ktx are shown in it, calendar times without a zone are read in it,
				and agents' dates without an offset mean it. Now: { v.Now }.
			</p>
			<button type="submit" class="primary">Save</button>
		</form>
	}
}

templ signInPage(v signInView) {
	@layout("Sign in to "+v.Title, v.Chrome) {
		<section class="narrow">
			<p class="back"><a href="/settings/connections">← Connections</a></p>
			<h1>Sign in to { v.Title }</h1>
			<ol class="steps">
				<li>
					<a class="button primary" href={ templ.SafeURL(v.Pending.Prompt.URL) } target="_blank" rel="noopener noreferrer">Open the sign-in page</a>
				</li>
				<li>Check it shows this code, then approve: <code class="code">{ v.Pending.Prompt.Code }</code></li>
				<li>Come back here; this page continues by itself.</li>
			</ol>
			@signInWaiting(v.Pending.ID)
			<p class="help">The code is valid until { v.Pending.Prompt.Expires.In(calendar.DefaultZone()).Format("15:04") }. ktx keeps the session encrypted; it never sees your password.</p>
		</section>
	}
}

templ signInWaiting(id string) {
	<p class="pending" hx-get={ "/settings/connections/signin/" + id + "/status" } hx-trigger="every 3s" hx-swap="outerHTML">Waiting for approval…</p>
}

templ signInStatus(msg string) {
	@flashBox(flash{"error", msg + " "})
	<p><a class="button" href="/settings/connections">Back to Connections</a></p>
}
