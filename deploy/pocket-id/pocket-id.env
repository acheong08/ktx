# /etc/pocket-id/pocket-id.env
APP_URL=https://id.internal.melzi.dev
APP_NAME=Melzi
# Caddy talks to Pocket ID over this socket; the container has no network.
# The socket is world-connectable, but its directory admits only pocketid and caddy.
UNIX_SOCKET=/run/pocket-id/pocket-id.sock
UNIX_SOCKET_MODE=0666
# Only Caddy can reach the socket, so its X-Forwarded-For can be trusted.
TRUST_PROXY=true
ENCRYPTION_KEY_FILE=/run/secrets/encryption_key
# Admin key for provisioning (OIDC clients, groups, invites) from the box.
STATIC_API_KEY_FILE=/run/secrets/static_api_key
ALLOW_INSECURE_CALLBACK_URLS=false
ALLOW_USER_SIGNUPS=disabled
ANALYTICS_DISABLED=true
VERSION_CHECK_DISABLED=true
ICON_LIBRARY_URL=disabled
