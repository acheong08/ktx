# /etc/ktx/brain-server.env (root:ktx, mode 640)
BRAIN_REPO_URL=git@github.com:melzi-cloud/company-brain.git
BRAIN_BRANCH=main
BRAIN_WORKDIR=/var/lib/ktx/company-brain
BRAIN_SSH_KEY_PATH=/etc/ktx/company-brain.key
BRAIN_SSH_KNOWN_HOSTS=/etc/ktx/known_hosts
BRAIN_LISTEN_ADDR=127.0.0.1:8080
BRAIN_GIT_AUTHOR_NAME=ktx
BRAIN_GIT_AUTHOR_EMAIL=ktx@melzi.dev
# Optional fixed tokens; people can also create their own on the API tokens page.
BRAIN_API_TOKENS=antonio:<openssl rand -hex 32>,maxim:<openssl rand -hex 32>
BRAIN_STATE_DB=/var/lib/ktx/state.db
# Sign-in through Pocket ID (set up by pocket-id-provision).
BRAIN_OIDC_ISSUER=https://id.internal.melzi.dev
BRAIN_OIDC_CLIENT_ID=ktx
BRAIN_OIDC_CLIENT_SECRET_FILE=/etc/ktx/oidc-client-secret
BRAIN_OIDC_ADMIN_GROUP=ktx-admins
BRAIN_PUBLIC_URL=https://brain.internal.melzi.dev
