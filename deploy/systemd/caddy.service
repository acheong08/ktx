[Unit]
Description=Caddy (ktx build)
Documentation=https://caddyserver.com/docs/
After=network-online.target tailscaled.service
Wants=network-online.target
# Keep retrying: the tailnet address may appear a little after boot.
StartLimitIntervalSec=0

[Service]
Type=notify
User=caddy
Group=caddy
EnvironmentFile=/etc/caddy/caddy.env
# Stay stopped (not failed) until the Cloudflare token is filled in.
# caddy-reload.path starts Caddy once /etc/caddy/caddy.env is written.
ExecCondition=/usr/bin/grep -q '^CLOUDFLARE_API_TOKEN=..*' /etc/caddy/caddy.env
ExecStart=/opt/ktx/current/caddy run --config /etc/caddy/Caddyfile
ExecReload=/opt/ktx/current/caddy reload --config /etc/caddy/Caddyfile --force
TimeoutStopSec=5s
LimitNOFILE=1048576
Restart=on-failure
RestartSec=5s

# Sandbox. It needs: ports 80/443 (CAP_NET_BIND_SERVICE), its data in
# /var/lib/caddy, the config in /etc/caddy, Unix sockets of the sites it
# proxies (e.g. /run/pocket-id), and netlink to read the tailnet address.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caddy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
